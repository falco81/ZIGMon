# /etc/systemd/system/zigmon-root.path (5.18)
#
# Watches for what the dashboard asks of root: the zigmon service lays a
# request down in /var/lib/zigmon/root/ - the certificate, who may reach which
# page, the firewall, a backup of the whole installation - or asks to be told
# what is in place now (look.ask), and this starts zigmon-root.service, which
# checks every value as root and does that and nothing else.
[Unit]
# no limit on how often it starts: the default (five in ten seconds) was
# reached by a few backups deleted one after another on the dashboard, and
# then nothing more was taken until somebody ran systemctl reset-failed
StartLimitIntervalSec=0
Description=zigmon - what the dashboard asks of root

[Path]
PathExists=/var/lib/zigmon/root/request.json
PathExists=/var/lib/zigmon/root/look.ask
# the network, restarting and switching off, and the clock (5.21): asked
# beside request.json, never behind a backup laid down in it
PathExists=/var/lib/zigmon/root/net.ask
PathExists=/var/lib/zigmon/root/ntp.ask
# the updates of the system (5.34): only started here - the job runs in a
# unit of its own, and never holds anything else up
PathExists=/var/lib/zigmon/root/osup.ask
# the system's trusted roots: certificate authorities of one's own put beside
# the distribution's list (update-ca-trust, update-ca-certificates)
PathExists=/var/lib/zigmon/root/osroots.ask
# SELinux: a look, a step on the way to enforcing, a report
PathExists=/var/lib/zigmon/root/selinux.ask
Unit=zigmon-root.service

[Install]
WantedBy=multi-user.target
