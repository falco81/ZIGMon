<Window x:Class="ZigmonNotifier.Views.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZIGMon Notifier menu"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Left="-32000" Top="-32000"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="RowGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="Width" Value="20" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style x:Key="Rule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Margin" Value="8,5" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="14" Width="304" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="8" />
        </Grid.RenderTransform>
        <Border CornerRadius="12" Background="{StaticResource PanelBrush}" Effect="{StaticResource CardShadow}" />
        <Border CornerRadius="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="6">
            <StackPanel x:Name="Items" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle">

                <!-- who, where, how it goes -->
                <Grid Margin="10,10,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="21" BorderThickness="1" VerticalAlignment="Top"
                            BorderBrush="{StaticResource InfoEdgeBrush}">
                        <Border.Background>
                            <RadialGradientBrush GradientOrigin="0.5,0.35" Center="0.5,0.35" RadiusX="0.7" RadiusY="0.7">
                                <GradientStop Color="#4758A6FF" Offset="0" />
                                <GradientStop Color="#1258A6FF" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                        <Viewbox Width="22" Height="22">
                            <Path x:Name="Mark" Style="{StaticResource StrokeIcon}" Stroke="{StaticResource InfoBrush}" />
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="ZIGMon Notifier" />
                        <TextBlock x:Name="HouseText" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" FontSize="12.5" Margin="7,0,0,0" Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap" MaxWidth="200" />
                        </StackPanel>
                        <TextBlock x:Name="ProblemText" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                   TextWrapping="Wrap" Margin="15,3,0,0" MaxWidth="200" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Rule}" />

                <Button x:Name="SensorsRow" Style="{StaticResource MenuRow}" Click="OnSensors">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE8FD;" />
                        <TextBlock Grid.Column="1" Text="Watched sensors&#x2026;" VerticalAlignment="Center" />
                        <TextBlock x:Name="SensorsNote" Grid.Column="2" Style="{StaticResource RowNote}" />
                    </Grid>
                </Button>
                <Button x:Name="ConnectionRow" Style="{StaticResource MenuRow}" Click="OnConnection">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE71B;" />
                        <TextBlock Grid.Column="1" Text="Connection&#x2026;" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Border Style="{StaticResource Rule}" />

                <Button x:Name="PauseRow" Style="{StaticResource MenuRow}" Click="OnPauseRow">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PauseGlyph" Style="{StaticResource RowGlyph}" Text="&#xE769;" />
                        <TextBlock Grid.Column="1" Text="Pause alerts" VerticalAlignment="Center" />
                        <TextBlock x:Name="PauseNote" Grid.Column="2" Style="{StaticResource RowNote}" Foreground="{StaticResource WarnBrush}"
                                   MaxWidth="120" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PauseChevron" Grid.Column="3" Style="{StaticResource Glyph}" FontSize="10" Margin="10,0,2,0"
                                   Foreground="{StaticResource TextMutedBrush}" Text="&#xE70D;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="ChevronTurn" Angle="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Button>
                <StackPanel x:Name="PausePanel" Margin="32,0,0,2" Visibility="Collapsed">
                    <Button Style="{StaticResource MenuRow}" Padding="10,6" Click="OnPause15" Content="For 15 minutes" />
                    <Button Style="{StaticResource MenuRow}" Padding="10,6" Click="OnPause60" Content="For 1 hour" />
                    <Button Style="{StaticResource MenuRow}" Padding="10,6" Click="OnPauseForever" Content="Until I resume them" />
                    <Button x:Name="ResumeRow" Style="{StaticResource MenuRow}" Padding="10,6" Click="OnResume">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource OkBrush}" Text="&#xE768;" />
                            <TextBlock Text="Resume alerts now" Margin="8,0,0,0" Foreground="{StaticResource OkBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Style="{StaticResource Rule}" />

                <ToggleButton x:Name="SoundToggle" Style="{StaticResource MenuToggle}" Click="OnSound">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE767;" />
                        <TextBlock Text="Sound" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="FrontToggle" Style="{StaticResource MenuToggle}" Click="OnFront"
                              ToolTip="Alerts always show on top. With this on they also take the keyboard focus.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE8A7;" />
                        <TextBlock Text="Bring to front and take focus" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="AutoCloseToggle" Style="{StaticResource MenuToggle}" Click="OnAutoClose">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE916;" />
                        <TextBlock Text="Close alerts after a minute" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="StartToggle" Style="{StaticResource MenuToggle}" Click="OnStart">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE7F4;" />
                        <TextBlock Text="Start with Windows" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <Border Style="{StaticResource Rule}" />

                <!-- updates: from the ZIGMon this app is connected to, signed with ZIGMon's release key -->
                <ToggleButton x:Name="AutoUpdateToggle" Style="{StaticResource MenuToggle}" Click="OnAutoUpdate"
                              ToolTip="Install new versions from your ZIGMon by themselves. Every update is checked against ZIGMon's release key first.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE895;" />
                        <TextBlock Text="Update automatically" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="UpdateRow" Style="{StaticResource MenuRow}" Click="OnUpdateRow">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UpdateGlyph" Style="{StaticResource RowGlyph}" Text="&#xE777;" />
                        <TextBlock x:Name="UpdateRowText" Grid.Column="1" Text="Check for updates now" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Grid Margin="42,0,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="UpdateDot" Width="6" Height="6" VerticalAlignment="Top" Margin="0,5,0,0"
                             Fill="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="UpdateStatusText" Grid.Column="1" FontSize="12" Margin="7,0,0,0"
                               Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" MaxWidth="220" />
                </Grid>

                <Border Style="{StaticResource Rule}" />

                <Button Style="{StaticResource MenuRow}" Click="OnTest">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xEA8F;" />
                        <TextBlock Text="Test alert" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenRow" Style="{StaticResource MenuRow}" Click="OnOpen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE774;" />
                        <TextBlock Text="Open ZIGMon" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Rule}" />

                <Button Style="{StaticResource MenuRow}" Click="OnExit">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE7E8;" />
                        <TextBlock Grid.Column="1" Text="Exit" VerticalAlignment="Center" />
                        <TextBlock x:Name="VersionNote" Grid.Column="2" Style="{StaticResource RowNote}" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
