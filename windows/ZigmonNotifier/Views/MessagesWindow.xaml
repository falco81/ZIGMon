<Window x:Class="ZigmonNotifier.Views.MessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messages &#x2013; ZIGMon Notifier"
        Width="1000" Height="690" MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- one conversation in the list on the left -->
        <DataTemplate x:Key="ConversationTemplate">
            <Grid Margin="10,9,12,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40" VerticalAlignment="Top">
                    <Ellipse Fill="{Binding AccentSoft}" Stroke="{Binding AccentEdge}" StrokeThickness="1" />
                    <TextBlock Text="{Binding Initials}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Glyph}" FontSize="16" Foreground="{Binding Accent}" Text="&#xE77B;"
                               Visibility="{Binding GlyphVisibility}" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="11.5" Margin="8,1,0,0"
                                   Foreground="{Binding WhenBrush}" />
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Preview}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextDimBrush}" />
                        <Ellipse Grid.Column="1" Width="8" Height="8" Margin="8,0,0,0" Fill="{StaticResource InfoBrush}"
                                 Visibility="{Binding UnreadVisibility}" ToolTip="New" />
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- a suggestion under the To box -->
        <DataTemplate x:Key="SuggestionTemplate">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="14" Background="{Binding AccentSoft}">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="12" Foreground="{Binding Accent}" Text="{Binding Glyph}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource WarnBrush}"
                           Text="&#xE735;" Margin="8,0,0,0" Visibility="{Binding FavouriteVisibility}" ToolTip="Favourite" />
            </Grid>
        </DataTemplate>

        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Margin="6,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InfoSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" MinWidth="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== the conversations ===== -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="20,20,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Title}" Text="Messages" />
                        <TextBlock x:Name="HouseText" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="NewButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Padding="12,7" Click="OnNew"
                            ToolTip="Write a new message (Ctrl+N)" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE70F;" />
                            <TextBlock Text="New" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="14,0,14,10">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Padding="34,7,10,7" MaxLength="60" FontSize="13"
                             Tag="Search people, numbers, text" TextChanged="OnSearch" />
                    <TextBlock Style="{StaticResource Glyph}" FontSize="12.5" Margin="13,0,0,0" HorizontalAlignment="Left"
                               Foreground="{StaticResource TextMutedBrush}" Text="&#xE721;" IsHitTestVisible="False" />
                </Grid>

                <ListBox x:Name="List" Grid.Row="2" ItemTemplate="{StaticResource ConversationTemplate}" ItemContainerStyle="{StaticResource PlainItem}"
                         Background="Transparent" BorderThickness="0" Padding="0,0,0,6" Foreground="{StaticResource TextBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionChanged="OnPick" />

                <StackPanel x:Name="ListEmpty" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="26" Visibility="Collapsed">
                    <TextBlock x:Name="ListEmptyGlyph" Style="{StaticResource Glyph}" FontSize="28" Foreground="{StaticResource TextMutedBrush}" Text="&#xE8BD;" />
                    <TextBlock x:Name="ListEmptyTitle" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" Text="No messages yet" />
                    <TextBlock x:Name="ListEmptyBody" Style="{StaticResource Lede}" FontSize="12.5" TextAlignment="Center" MaxWidth="240" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,10,10,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="FootDot" Width="7" Height="7" Fill="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="Footer" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="OnRefresh" ToolTip="Read again from ZIGMon (F5)">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE72C;" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===== the conversation, or a new message ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- whose it is -->
            <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,16,18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="42" Height="42">
                        <Ellipse x:Name="HeadAvatar" Fill="{StaticResource InfoSoftBrush}" Stroke="{StaticResource InfoEdgeBrush}" StrokeThickness="1" />
                        <TextBlock x:Name="HeadInitials" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeadGlyph" Style="{StaticResource Glyph}" FontSize="17" Foreground="{StaticResource InfoBrush}" Text="&#xE70F;" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="13,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeadTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="New message" />
                        <TextBlock x:Name="HeadSub" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" Text="To people from your contacts, groups or any number" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CopyNumberButton" Style="{StaticResource IconButton}" Click="OnCopyNumber" ToolTip="Copy the number">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE8C8;" />
                        </Button>
                        <Button x:Name="ToNewButton" Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="OnForward"
                                ToolTip="A new message to this person, with others">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE716;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- To: chips with autocomplete, and the favourites as quick chips -->
            <StackPanel x:Name="ToPanel" Grid.Row="1" Margin="24,14,24,0">
                <Border x:Name="ToFrame" CornerRadius="10" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Padding="10,5,8,5" MouseLeftButtonDown="OnToFrameClick" Cursor="IBeam">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="To" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Top" Margin="2,6,10,0" />
                        <WrapPanel x:Name="Chips" Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="ToBox" Style="{StaticResource BareField}" MinWidth="200" MaxLength="100"
                                     Tag="Name, group or number" Margin="0,2"
                                     TextChanged="OnToChanged" PreviewKeyDown="OnToKey" LostKeyboardFocus="OnToLostFocus" />
                        </WrapPanel>
                    </Grid>
                </Border>
                <Popup x:Name="Suggest" PlacementTarget="{Binding ElementName=ToBox}" Placement="Bottom" VerticalOffset="8"
                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" Focusable="False">
                    <Grid Margin="0,0,14,14">
                        <Border CornerRadius="10" Background="{StaticResource PanelBrush}" Effect="{StaticResource CardShadow}" />
                        <Border CornerRadius="10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="0,5">
                            <ListBox x:Name="SuggestList" Width="340" MaxHeight="320" ItemTemplate="{StaticResource SuggestionTemplate}"
                                     ItemContainerStyle="{StaticResource PlainItem}" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextBrush}" Focusable="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonDown="OnSuggestClick" />
                        </Border>
                    </Grid>
                </Popup>
                <TextBlock x:Name="ToProblem" Style="{StaticResource Hint}" Foreground="{StaticResource WarnBrush}" Margin="4,6,0,0" Visibility="Collapsed" />
                <StackPanel x:Name="FavRow" Orientation="Horizontal" Margin="2,10,0,0">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource WarnBrush}" Text="&#xE735;" />
                    <TextBlock Text="Favourites" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,10,0" VerticalAlignment="Center" />
                    <WrapPanel x:Name="Favourites" />
                </StackPanel>
            </StackPanel>

            <!-- the conversation's bubbles -->
            <Grid Grid.Row="2">
                <ScrollViewer x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,14,20,14">
                    <StackPanel x:Name="Bubbles" />
                </ScrollViewer>
                <StackPanel x:Name="ThreadEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                    <Grid Width="64" Height="64" HorizontalAlignment="Center">
                        <Ellipse Fill="{StaticResource InfoSoftBrush}" Stroke="{StaticResource InfoEdgeBrush}" StrokeThickness="1" />
                        <TextBlock Style="{StaticResource Glyph}" FontSize="26" Foreground="{StaticResource InfoBrush}" Text="&#xE8BD;" />
                    </Grid>
                    <TextBlock x:Name="ThreadEmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"
                               Text="Write to anyone in your contacts" />
                    <TextBlock x:Name="ThreadEmptyBody" Style="{StaticResource Lede}" TextAlignment="Center" MaxWidth="380" Margin="0,4,0,0"
                               Text="Type a name, a group or a number above. ZIGMon sends it from its own SMS gateway, with its own limits." />
                </StackPanel>
            </Grid>

            <!-- writing -->
            <Border x:Name="ComposeArea" Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14,24,16"
                    Background="{StaticResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageText" Style="{StaticResource AreaField}" MinHeight="76" MaxHeight="210" MaxLength="1530"
                             Tag="Write a message…" TextChanged="OnTextChanged" PreviewKeyDown="OnTextKey" />
                    <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Padding="18,0"
                            VerticalAlignment="Stretch" MinHeight="76" Click="OnSend" IsEnabled="False" ToolTip="Send (Ctrl+Enter)">
                        <StackPanel>
                            <TextBlock x:Name="SendGlyph" Style="{StaticResource Glyph}" FontSize="18" Text="&#xE724;" HorizontalAlignment="Center" />
                            <TextBlock x:Name="SendText" Text="Send" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="2,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CounterChip" CornerRadius="8" Padding="8,2,8,3" Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                ToolTip="Characters, and how many SMS the network sends it as: 160 a part (153 when split); with accents or emoji 70 (67)">
                            <TextBlock x:Name="Counter" FontSize="12" Foreground="{StaticResource TextDimBrush}" Text="0 / 160 · 0 SMS" />
                        </Border>
                        <TextBlock x:Name="ToCount" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                   Text="Ctrl+Enter sends" />
                    </Grid>
                    <Border x:Name="Feedback" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" CornerRadius="8" Padding="11,8"
                            BorderThickness="1" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FeedbackGlyph" Style="{StaticResource Glyph}" FontSize="13" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <TextBlock x:Name="FeedbackText" Grid.Column="1" FontSize="13" Margin="9,0,0,0" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="ComposeOff" Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,16"
                    Background="{StaticResource PanelBrush}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Text="&#xE72E;" />
                    <TextBlock x:Name="ComposeOffText" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="560" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
