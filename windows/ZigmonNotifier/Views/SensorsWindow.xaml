<Window x:Class="ZigmonNotifier.Views.SensorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ZigmonNotifier.Views"
        Title="Watched sensors &#x2013; ZIGMon Notifier"
        Width="620" Height="700" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}" FontSize="13.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type v:SensorRow}">
            <Border Padding="14,11" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Width="38" Height="38" CornerRadius="11" BorderThickness="1"
                            Background="{Binding AccentSoft}" BorderBrush="{Binding AccentEdge}" VerticalAlignment="Center">
                        <Viewbox Width="21" Height="21">
                            <Path Style="{StaticResource StrokeIcon}" Data="{Binding Icon}" Stroke="{Binding Accent}" />
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="13,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>

                    <Border Grid.Row="0" Grid.Column="2" CornerRadius="10" Padding="9,2,9,3" BorderThickness="1" VerticalAlignment="Center"
                            Background="{Binding StateBg}" BorderBrush="{Binding StateEdge}" ToolTip="{Binding StateTip}">
                        <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StateFg}" />
                    </Border>

                    <CheckBox Grid.Row="0" Grid.Column="3" Style="{StaticResource Switch}" Margin="16,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsWatched, Mode=TwoWay}" ToolTip="Alert me when this sensor triggers" />

                    <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Tick}" Margin="13,9,0,0"
                              HorizontalAlignment="Left" Visibility="{Binding ClearsVisibility}"
                              IsChecked="{Binding AlsoWhenClears, Mode=TwoWay}">
                        <TextBlock Text="{Binding ClearsText}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" />
                    </CheckBox>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Title}" Text="Watched sensors" />
            <TextBlock x:Name="Summary" Style="{StaticResource Lede}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Padding="34,8,10,8" MaxLength="80"
                         Tag="Search by name, room or kind" TextChanged="OnSearch" />
                <TextBlock Style="{StaticResource Glyph}" FontSize="13" Margin="13,0,0,0" HorizontalAlignment="Left"
                           Foreground="{StaticResource TextMutedBrush}" Text="&#xE721;" IsHitTestVisible="False" />
            </Grid>
            <Button Grid.Column="1" x:Name="AllButton" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnAll"
                    Content="Watch all" ToolTip="Watch every sensor shown below" />
            <Button Grid.Column="2" x:Name="NoneButton" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnNone"
                    Content="None" ToolTip="Stop watching every sensor shown below" />
        </Grid>

        <Border Grid.Row="2" CornerRadius="12" BorderThickness="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" Padding="0,2">
            <Grid>
                <ListBox x:Name="List" ItemTemplate="{StaticResource RowTemplate}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         KeyboardNavigation.TabNavigation="Continue">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyGlyph" Style="{StaticResource Glyph}" FontSize="30" Foreground="{StaticResource TextMutedBrush}"
                               Text="&#xE71B;" />
                    <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock x:Name="EmptyBody" Style="{StaticResource Lede}" TextAlignment="Center" MaxWidth="360" Margin="0,4,0,0" />
                    <Button x:Name="EmptyButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                            Margin="0,16,0,0" Content="Set up the connection" Click="OnSetUp" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="FootDot" Width="8" Height="8" Fill="{StaticResource TextDimBrush}" />
                <TextBlock x:Name="Footer" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Done" Click="OnDone" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
