<Window x:Class="ZigmonNotifier.Views.SmsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMS"
        Width="416" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SmallGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="12" Opacity="0">
        <!-- the shadow on its own layer, so the text above stays sharp (as the alert cards) -->
        <Border CornerRadius="14" Background="{StaticResource PanelBrush}" Effect="{StaticResource CardShadow}" />
        <Border CornerRadius="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- the stripe, in the person's own colour -->
                <Border x:Name="Stripe" Grid.Column="0" CornerRadius="13,0,0,13" Background="{StaticResource InfoBrush}" />

                <Grid Grid.Column="1" Margin="14,14,10,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- the avatar: initials on a round tile in the person's colour, a ring that pulses on arrival -->
                    <Grid Grid.Row="0" Grid.Column="0" Width="46" Height="46" VerticalAlignment="Top">
                        <Ellipse x:Name="Pulse" StrokeThickness="2" Stroke="{StaticResource InfoBrush}" Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Avatar" Fill="{StaticResource InfoSoftBrush}" Stroke="{StaticResource InfoEdgeBrush}" StrokeThickness="1" />
                        <TextBlock x:Name="Initials" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="PersonGlyph" Style="{StaticResource Glyph}" FontSize="19" Foreground="{StaticResource InfoBrush}"
                                   Text="&#xE77B;" Visibility="Collapsed" />
                        <!-- the SMS badge on the avatar's corner -->
                        <Border Width="19" Height="19" CornerRadius="9.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,-3,-3" Background="{StaticResource InfoBrush}" BorderBrush="{StaticResource PanelBrush}" BorderThickness="2">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="8.5" Foreground="{StaticResource BgBrush}" Text="&#xE8BD;" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="13,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Headline" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" Text="SMS" />
                            <TextBlock x:Name="When" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" />
                            <Border x:Name="CountBadge" Margin="8,0,0,0" CornerRadius="8" Padding="6,0" Visibility="Collapsed"
                                    Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <TextBlock x:Name="CountText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="WhoText" FontSize="16" FontWeight="SemiBold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NumberText" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" FontFamily="{StaticResource UiFont}" />
                    </StackPanel>

                    <Button x:Name="CloseButton" Grid.Row="0" Grid.Column="2" Style="{StaticResource IconButton}"
                            VerticalAlignment="Top" Content="&#xE711;" ToolTip="Dismiss (Esc)" Click="OnDismiss" />

                    <!-- the message: plain text, scrolls when long; earlier ones from the same person above it -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,4,0" CornerRadius="4,12,12,12"
                            Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <ScrollViewer x:Name="Scroller" MaxHeight="176" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="12,9,6,10" Focusable="False">
                            <StackPanel x:Name="Thread">
                                <StackPanel x:Name="Earlier" />
                                <TextBlock x:Name="Body" FontSize="14" TextWrapping="Wrap" LineHeight="20" Margin="0,0,6,0"
                                           Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- the inline reply -->
                    <StackPanel x:Name="ReplyPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,4,0" Visibility="Collapsed">
                        <TextBox x:Name="ReplyBox" Style="{StaticResource AreaField}" MinHeight="66" MaxHeight="150" FontSize="13.5"
                                 MaxLength="1530" Tag="Write a reply…" TextChanged="OnReplyChanged" PreviewKeyDown="OnReplyKey" />
                        <Grid Margin="2,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CounterChip" CornerRadius="8" Padding="7,1,7,2" Background="{StaticResource Panel2Brush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    ToolTip="Characters, and how many SMS the network sends it as (160 a part, 153 when split; with accents or emoji 70 / 67)">
                                <TextBlock x:Name="Counter" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" Text="0 / 160 · 0 SMS" />
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Text="Ctrl+Enter sends" />
                        </Grid>
                    </StackPanel>

                    <!-- what came of a send -->
                    <Border x:Name="Feedback" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,4,0" CornerRadius="8" Padding="10,7"
                            BorderThickness="1" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FeedbackGlyph" Style="{StaticResource SmallGlyph}" />
                            <TextBlock x:Name="FeedbackText" FontSize="12.5" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="300" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ThreadButton" Style="{StaticResource IconButton}" Click="OnOpenThread" ToolTip="Open the conversation in Messages">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="&#xE8F2;" />
                            </Button>
                            <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="OnCopy" ToolTip="Copy the text">
                                <TextBlock x:Name="CopyGlyph" Style="{StaticResource Glyph}" FontSize="14" Text="&#xE8C8;" />
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="ReadButtons" Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="ReplyButton" Style="{StaticResource PrimaryButton}" Padding="13,6" Click="OnReply">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SmallGlyph}" Text="&#xE97A;" />
                                    <TextBlock Text="Reply" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DismissButton" Style="{StaticResource GhostButton}" Padding="13,6" Margin="8,0,0,0"
                                    Content="Dismiss" Click="OnDismiss" />
                        </StackPanel>
                        <StackPanel x:Name="ReplyButtons" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed">
                            <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Padding="13,6" Content="Cancel" Click="OnCancelReply" />
                            <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Padding="13,6" Margin="8,0,0,0" Click="OnSend"
                                    IsEnabled="False" ToolTip="Send (Ctrl+Enter)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SendGlyph" Style="{StaticResource SmallGlyph}" Text="&#xE724;" />
                                    <TextBlock x:Name="SendText" Text="Send" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
