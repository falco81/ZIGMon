{
  "name": "zigmon-streamdeck",
  "version": "1.3.0",
  "private": true,
  "description": "ZIGMon for Stream Deck - control and watch a ZIGMon home from a Stream Deck XL or Stream Deck +",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-release-keys.mjs",
    "build": "rollup -c",
    "test": "tsc -p tsconfig.test.json && node --test --test-reporter=spec out/test/*.test.js",
    "validate": "streamdeck validate com.zigmon.streamdeck.sdPlugin"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.5",
    "@elgato/schemas": "0.6.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.1",
    "@tsconfig/node20": "20.1.11",
    "@types/node": "24.1.0",
    "ajv": "8.20.0",
    "rollup": "4.68.9",
    "tslib": "2.9.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.6",
    "@elgato/utils": "0.7.0"
  }
}
